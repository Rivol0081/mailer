# Telegram bot token from @BotFather
BOT_TOKEN=

# Fernet key for encrypting stored IMAP passwords.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# SQLite database path (default: ./data/mailer.db)
DB_PATH=./data/mailer.db

# Interval in seconds for client-side filter polling loop
FILTER_INTERVAL=120

# Comma-separated Telegram user IDs allowed to administer the bot (manage whitelist).
# These users can also add others via /allow. If empty, the FIRST user to /start
# becomes the bootstrap admin.
ADMIN_IDS=
